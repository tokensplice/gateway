# ============================================================
# TokenSplice Gateway — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Core ---
PORT=3000
# VERSION is set at build time; override only for development
# VERSION=v1.0.0-rc.1

# --- Branding (white-label) ---
# These set the INITIAL display values. Admins can override in the web console.
SYSTEM_NAME=TokenSplice
LOGO_URL=https://tokensplice.com/logo.svg
FOOTER=Powered by TokenSplice Gateway
TOP_UP_LINK=https://tokensplice.com/pricing

# --- Security (CRITICAL — set these in production!) ---
# Without SESSION_SECRET, a random UUID is generated per boot → all sessions die on restart.
SESSION_SECRET=change-me-to-a-random-32-char-string
# Without CRYPTO_SECRET, it falls back to SESSION_SECRET.
# This encrypts BYOK keys and channel API keys in the database.
# If it changes, all stored encrypted keys become unrecoverable.
CRYPTO_SECRET=change-me-to-a-different-random-32-char-string

# --- Database ---
# MySQL (recommended for production)
# SQL_DSN=root:password@tcp(localhost:3306)/tokensplice?parseTime=true&loc=Local
# SQLite (default, development only)
# SQLITE_PATH=./data/gateway.db

# --- Redis (optional, for caching + distributed sessions) ---
# REDIS_CONN_STRING=redis://localhost:6379

# --- Node Type ---
# master (default) or slave
# NODE_TYPE=master

# --- Debug ---
# DEBUG=true

# --- Memory Cache ---
# MEMORY_CACHE_ENABLED=true

# --- Relay / Proxy ---
# Timeout in seconds for relay requests (0 = no timeout)
# RELAY_TIMEOUT=0
# Idle connection timeout (seconds)
# RELAY_IDLE_CONN_TIMEOUT=90
# Response header timeout (seconds)
# RELAY_RESPONSE_HEADER_TIMEOUT=1800
# Max idle connections
# RELAY_MAX_IDLE_CONNS=500
# Max idle connections per host
# RELAY_MAX_IDLE_CONNS_PER_HOST=100

# --- Rate Limiting ---
# GLOBAL_API_RATE_LIMIT_ENABLE=true
# GLOBAL_API_RATE_LIMIT=360
# GLOBAL_API_RATE_LIMIT_DURATION=180
# GLOBAL_WEB_RATE_LIMIT_ENABLE=true
# GLOBAL_WEB_RATE_LIMIT=120
# GLOBAL_WEB_RATE_LIMIT_DURATION=180
# CRITICAL_RATE_LIMIT_ENABLE=true
# CRITICAL_RATE_LIMIT=20
# CRITICAL_RATE_LIMIT_DURATION=1200

# --- Sync & Batch ---
# SYNC_FREQUENCY=60
# BATCH_UPDATE_INTERVAL=5

# --- TLS ---
# TLS_INSECURE_SKIP_VERIFY=false

# --- SMTP (email notifications) ---
# SMTP_SERVER=
# SMTP_FROM=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS_ENABLE=false
# SMTP_INSECURE_SKIP_VERIFY=false

# --- OAuth ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINUXDO_CLIENT_ID=
# LINUXDO_CLIENT_SECRET=
# TELEGRAM_BOT_TOKEN=

# --- Misc ---
# POLLING_INTERVAL=0
# GEMINI_SAFETY_SETTING=BLOCK_NONE
# COHERE_SAFETY_SETTING=NONE
# AZURE_DEFAULT_API_VERSION=2025-04-01-preview
# GENERATE_DEFAULT_TOKEN=false
# ERROR_LOG_ENABLED=false
# TRUSTED_REDIRECT_DOMAINS=

# --- Multi-Currency Display (rc.3) ---
# Display-only conversion; internal billing always stays in quota.
# Auto-refresh exchange rates from open.er-api.com (no API key needed).
# CURRENCY_AUTO_UPDATE=true
# Refresh cadence in hours (minimum 1).
# CURRENCY_UPDATE_INTERVAL_HOURS=24
# Fallback display currency for users without a preferred_currency.
# Supported: USD, HKD, CNY, EUR, GBP, JPY, KRW, SGD, TWD
# DEFAULT_DISPLAY_CURRENCY=USD

# --- Task Plugin ---
# TASK_PLUGIN_ENABLED=true
# TASK_TIMEOUT_MINUTES=1440
# TASK_QUERY_LIMIT=1000
# TASK_POLL_MAX_FAILURES=20

# --- Observability (Prometheus) ---
# GET /metrics is served on the same port as the API, outside every auth group.
METRICS_ENABLED=true
# Leave empty ONLY when the endpoint is scraped inside a trusted network.
# When set, a scraper must send: Authorization: Bearer <METRICS_TOKEN>
# METRICS_TOKEN=change-me-to-a-random-string

# --- Request Limits ---
# MAX_REQUEST_BODY_MB=128
# MAX_FILE_DOWNLOAD_MB=64
# STREAM_SCANNER_MAX_BUFFER_MB=128
# STREAMING_TIMEOUT=300
# FORCE_STREAM_OPTION=true
