    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Customer keys currently eligible for routing. Refreshed from the database on the gateway's sync interval, so it survives a restart. A sudden drop means keys are being rejected upstream.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
